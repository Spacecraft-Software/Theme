        "support.type"
      ],
      "settings": {
        "foreground": "#FF46AA"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
