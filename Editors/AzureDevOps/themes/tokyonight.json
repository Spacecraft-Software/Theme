{
  "id": "spacecraft-software-tokyonight-theme",
  "type": "ms.vss-web.theme",
  "description": "Tokyo Night theme for Azure DevOps",
  "targets": [
    "ms.vss-web.theme-collection"
  ],
  "properties": {
    "name": "Tokyo Night",
    "uiTheme": "dark",
    "variables": {
      "background-color": "#1A1B26",
      "primary-text-color": "#C0CAF5",
      "secondary-text-color": "#BB9AF7",
      "primary-button-background": "#7AA2F7",
      "primary-button-text": "#1A1B26",
      "accent-color": "#7AA2F7",
      "error-color": "#F7768E",
      "success-color": "#9ECE6A",
      "warning-color": "#E0AF68",
