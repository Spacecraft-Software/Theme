      "tab_background_text": "#1C2433",
      "toolbar": "#F4F3F1",
      "toolbar_text": "#111827",
      "toolbar_field": "#D4D2CD",
      "toolbar_field_text": "#111827",
      "toolbar_field_border": "#1C2433",
      "toolbar_field_focus": "#D4D2CD",
      "toolbar_field_border_focus": "#1F4A73",
