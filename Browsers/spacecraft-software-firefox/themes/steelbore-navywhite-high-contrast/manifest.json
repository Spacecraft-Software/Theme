{
  "manifest_version": 2,
  "version": "2.0",
  "name": "Steelbore NavyWhite High Contrast",
  "description": "Steelbore NavyWhite High Contrast \u2014 the \u00a711.1.1 high-contrast Spacecraft Software theme for Mozilla Firefox.",
  "author": "Mohamed Hammad",
  "developer": {
    "name": "Mohamed Hammad",
    "url": "https://SpacecraftSoftware.org"
  },
  "homepage_url": "https://SpacecraftSoftware.org",
  "browser_specific_settings": {
    "gecko": {
      "id": "spacecraft-steelbore-navywhite-high-contrast-firefox@SpacecraftSoftware.org",
      "strict_min_version": "63.0"
    }
