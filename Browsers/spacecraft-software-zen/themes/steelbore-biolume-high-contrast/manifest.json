      "popup_text": "#C7D2D9",
      "popup_border": "#00F0FF",
      "popup_highlight": "#B6FF3B",
      "popup_highlight_text": "#0C1A2B",
      "sidebar": "#0C1A2B",
      "sidebar_text": "#C7D2D9",
      "sidebar_border": "#00F0FF",
      "sidebar_highlight": "#B6FF3B",
      "sidebar_highlight_text": "#0C1A2B",
      "bookmark_text": "#C7D2D9",
      "button_background_hover": "#1B2630",
