{
  "manifest_version": 2,
  "version": "2.0",
  "name": "Steelbore",
  "description": "Steelbore \u2014 a Spacecraft Software Steelbore palette theme for Tor Browser.",
  "author": "Mohamed Hammad",
  "developer": {
    "name": "Mohamed Hammad",
    "url": "https://SpacecraftSoftware.org"
  },
  "homepage_url": "https://SpacecraftSoftware.org",
  "browser_specific_settings": {
    "gecko": {
      "id": "spacecraft-steelbore-tor@SpacecraftSoftware.org",
      "strict_min_version": "63.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#000027",
      "frame_inactive": "#8A6CFF",
      "tab_background_text": "#8A6CFF",
      "toolbar": "#0E2A47",
      "toolbar_text": "#D9DEE5",
      "toolbar_field": "#0B1A12",
      "toolbar_field_text": "#D9DEE5",
      "toolbar_field_border": "#8A6CFF",
      "toolbar_field_focus": "#0B1A12",
      "toolbar_field_border_focus": "#B4FF00",
      "toolbar_field_highlight": "#FF5E00",
      "toolbar_field_highlight_text": "#000027",
      "toolbar_top_separator": "#8A6CFF",
      "toolbar_bottom_separator": "#000027",
      "tab_line": "#FF5E00",
      "tab_loading": "#FF5E00",
      "tab_selected": "#0E2A47",
      "tab_text": "#D9DEE5",
      "ntp_background": "#000027",
      "ntp_text": "#D9DEE5",
      "popup": "#0E2A47",
      "popup_text": "#D9DEE5",
      "popup_border": "#8A6CFF",
      "popup_highlight": "#FF5E00",
      "popup_highlight_text": "#000027",
      "sidebar": "#000027",
      "sidebar_text": "#D9DEE5",
      "sidebar_border": "#8A6CFF",
      "sidebar_highlight": "#FF5E00",
      "sidebar_highlight_text": "#000027",
      "bookmark_text": "#D9DEE5",
      "button_background_hover": "#0E2A47",
      "button_background_active": "#FF5E00",
      "icons": "#D9DEE5",
      "icons_attention": "#B4FF00"
    },
    "properties": {
      "color_scheme": "dark"
    }
  }
}
