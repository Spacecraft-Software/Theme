{
  "manifest_version": 2,
  "version": "2.0",
  "name": "Solarized Dark",
  "description": "Solarized Dark \u2014 a non-conforming \u00a711.5 fidelity palette, reproduced verbatim, for Tor Browser.",
  "author": "Mohamed Hammad",
  "developer": {
    "name": "Mohamed Hammad",
    "url": "https://SpacecraftSoftware.org"
  },
  "homepage_url": "https://SpacecraftSoftware.org",
  "browser_specific_settings": {
    "gecko": {
      "id": "spacecraft-solarized-dark-tor@SpacecraftSoftware.org",
      "strict_min_version": "63.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#002B36",
      "frame_inactive": "#6C71C4",
      "tab_background_text": "#6C71C4",
      "toolbar": "#073642",
      "toolbar_text": "#839496",
      "toolbar_field": "#073642",
      "toolbar_field_text": "#839496",
      "toolbar_field_border": "#6C71C4",
      "toolbar_field_focus": "#073642",
      "toolbar_field_border_focus": "#2AA198",
      "toolbar_field_highlight": "#268BD2",
      "toolbar_field_highlight_text": "#002B36",
      "toolbar_top_separator": "#6C71C4",
      "toolbar_bottom_separator": "#002B36",
      "tab_line": "#268BD2",
      "tab_loading": "#268BD2",
      "tab_selected": "#073642",
      "tab_text": "#839496",
      "ntp_background": "#002B36",
      "ntp_text": "#839496",
      "popup": "#073642",
      "popup_text": "#839496",
      "popup_border": "#6C71C4",
      "popup_highlight": "#268BD2",
      "popup_highlight_text": "#002B36",
      "sidebar": "#002B36",
      "sidebar_text": "#839496",
      "sidebar_border": "#6C71C4",
      "sidebar_highlight": "#268BD2",
      "sidebar_highlight_text": "#002B36",
      "bookmark_text": "#839496",
      "button_background_hover": "#073642",
      "button_background_active": "#268BD2",
      "icons": "#839496",
      "icons_attention": "#859900"
    },
    "properties": {
      "color_scheme": "dark"
    }
  }
