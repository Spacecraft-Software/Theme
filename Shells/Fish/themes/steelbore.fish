# Tab-completion pager colours
set -g fish_pager_color_prefix B4FF00
set -g fish_pager_color_completion D9DEE5
set -g fish_pager_color_description 8A6CFF
set -g fish_pager_color_progress B4FF00

# The prompt function
function fish_prompt
    set -l last_status $status

    # Working directory
    set_color 8A6CFF
    printf '%s' (prompt_pwd)
    set_color normal

    # Git branch, if any
    if type -q git
        set -l branch (git branch --show-current 2>/dev/null)
        if test -n "$branch"
            set_color FF5E00
            printf ' on  %s' $branch
            set_color normal
        end
    end

    # Status symbol
    if test $last_status -eq 0
        set_color B4FF00
    else
        set_color FF3B3B
    end
    printf ' ❯ '
    set_color normal
end
