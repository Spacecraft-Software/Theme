set -g fish_color_end 8A6CFF
set -g fish_color_error FF3B3B
set -g fish_color_param 8A6CFF
set -g fish_color_comment 8A6CFF
set -g fish_color_selection --background=0E2A47
set -g fish_color_search_match --background=0E2A47
set -g fish_color_operator B4FF00
set -g fish_color_escape B4FF00
