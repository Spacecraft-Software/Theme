# Steelbore Mono — Ion shell prompt theme
# GENERATED by tools/steelbore_themes from Steelbore/steelbore.toml (palette family v3.5.0, The Steelbore Standard §11 v2.08). Do not edit by hand — regenerate.
# Theme slug: steelbore-mono · palette: steelbore-mono · variant: mono (§11.1.1, 4-bit ANSI, NO_COLOR)
# Conformance: palette-independent; defers hue to the terminal (§11.1.1)
# Maintainer: Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org> · https://Theme.SpacecraftSoftware.org/
# Add to ~/.config/ion/initrc or source this file

# Colour variables (ANSI names for 4-bit mode)
let background = default
let foreground = default
let accent = bright-white
let structure = blue
let success = green
let error = red
let warning = yellow
let focus = reverse-video

# Prompt function using ANSI colour names
fn PROMPT
    let dir = "${c::blue}${PWD}${c::reset}"
    let symbol = "❯"
    
    if eq $? 0
        print "${dir} ${c::green}${symbol}${c::reset} "
    else
        print "${dir} ${c::red}${symbol}${c::reset} "
    end
end
