# Steelbore Classic High Contrast — Ion shell prompt theme
# GENERATED by tools/steelbore_themes from Steelbore/steelbore.toml (palette family v3.5.0, The Steelbore Standard §11 v2.08). Do not edit by hand — regenerate.
# Theme slug: steelbore-classic-high-contrast · palette: steelbore-classic · variant: high-contrast (§11.1.1 accessible-mode sibling)
# Conformance: legacy six-role contract (§11.2); measured against Void Navy
# Maintainer: Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org> · https://Theme.SpacecraftSoftware.org/
# Add to ~/.config/ion/initrc or source this file

# Colour variables (bare hex for truecolor)
let background = 000027
let foreground = D98E32
let accent = 7FAEDC
let structure = 7FAEDC
let success = 50FA7B
let error = FF8080
let warning = D98E32
let focus = 8BE9FD

# Prompt function using truecolor hex codes
fn PROMPT
    let dir = "${c::0x${structure}}${PWD}${c::reset}"
    let symbol = "❯"
    
    if eq $? 0
        print "${dir} ${c::0x${success}}${symbol}${c::reset} "
    else
        print "${dir} ${c::0x${error}}${symbol}${c::reset} "
    end
end
