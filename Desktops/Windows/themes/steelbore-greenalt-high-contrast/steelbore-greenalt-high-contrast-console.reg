[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:0008020D
"ColorTable01"=dword:006B6BFF
"ColorTable02"=dword:001CB800
"ColorTable03"=dword:0057C8FF
"ColorTable04"=dword:005FB825
"ColorTable05"=dword:0041FF00
"ColorTable06"=dword:0041FF00
"ColorTable07"=dword:00E0F5D7
"ColorTable08"=dword:005FB825
"ColorTable09"=dword:006B6BFF
"ColorTable10"=dword:001CB800
"ColorTable11"=dword:0057C8FF
"ColorTable12"=dword:005FB825
"ColorTable13"=dword:0041FF00
"ColorTable14"=dword:0041FF00
"ColorTable15"=dword:00E0F5D7

