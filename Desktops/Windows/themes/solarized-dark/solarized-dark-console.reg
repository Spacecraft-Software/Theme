[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00362B00
"ColorTable01"=dword:002F32DC
"ColorTable02"=dword:00009985
"ColorTable03"=dword:000089B5
"ColorTable04"=dword:00C4716C
"ColorTable05"=dword:00D28B26
"ColorTable06"=dword:0098A12A
"ColorTable07"=dword:00969483
"ColorTable08"=dword:00C4716C
"ColorTable09"=dword:002F32DC
"ColorTable10"=dword:00009985
"ColorTable11"=dword:000089B5
"ColorTable12"=dword:00C4716C
"ColorTable13"=dword:00D28B26
"ColorTable14"=dword:0098A12A
