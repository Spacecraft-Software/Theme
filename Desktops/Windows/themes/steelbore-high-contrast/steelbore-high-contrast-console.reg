[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00270000
"ColorTable01"=dword:007A7AFF
"ColorTable02"=dword:0000FFB4
"ColorTable03"=dword:00FF7BEE
"ColorTable04"=dword:00FFA1B3
"ColorTable05"=dword:003D8AFF
"ColorTable06"=dword:0000FFB4
"ColorTable07"=dword:00E5DED9
"ColorTable08"=dword:00FFA1B3
"ColorTable09"=dword:007A7AFF
"ColorTable10"=dword:0000FFB4
"ColorTable11"=dword:00FF7BEE
"ColorTable12"=dword:00FFA1B3
"ColorTable13"=dword:003D8AFF
"ColorTable14"=dword:0000FFB4
"ColorTable15"=dword:00E5DED9

