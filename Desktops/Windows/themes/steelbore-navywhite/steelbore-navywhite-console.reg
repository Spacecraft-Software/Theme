[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00E0E5E7
"ColorTable01"=dword:001F2193
"ColorTable02"=dword:0049632A
"ColorTable03"=dword:000C4E6F
"ColorTable04"=dword:0033241C
"ColorTable05"=dword:0080552A
"ColorTable06"=dword:0080552A
"ColorTable07"=dword:00271811
"ColorTable08"=dword:0033241C
"ColorTable09"=dword:001F2193
"ColorTable10"=dword:0049632A
"ColorTable11"=dword:000C4E6F
"ColorTable12"=dword:0033241C
"ColorTable13"=dword:0080552A
"ColorTable14"=dword:0080552A
"ColorTable15"=dword:00271811

