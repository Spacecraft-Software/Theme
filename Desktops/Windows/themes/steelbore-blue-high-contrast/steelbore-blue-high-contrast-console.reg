[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:0024100A
"ColorTable01"=dword:008F8FFF
"ColorTable02"=dword:006FC728
"ColorTable03"=dword:0057C8FF
"ColorTable04"=dword:00FFA366
"ColorTable05"=dword:00FFB479
"ColorTable06"=dword:004B8AFF
"ColorTable07"=dword:00FFF0E6
"ColorTable08"=dword:00FFA366
"ColorTable09"=dword:008F8FFF
"ColorTable10"=dword:006FC728
"ColorTable11"=dword:0057C8FF
"ColorTable12"=dword:00FFA366
"ColorTable13"=dword:00FFB479
"ColorTable14"=dword:004B8AFF
"ColorTable15"=dword:00FFF0E6

