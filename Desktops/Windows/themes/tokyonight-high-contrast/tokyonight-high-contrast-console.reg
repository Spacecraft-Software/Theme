[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00261B1A
"ColorTable01"=dword:00AA98F9
"ColorTable02"=dword:006ACE9E
"ColorTable03"=dword:0068AFE0
"ColorTable04"=dword:00F79ABB
"ColorTable05"=dword:00F9B697
"ColorTable06"=dword:00FFCF7D
"ColorTable07"=dword:00F5CAC0
"ColorTable08"=dword:00F79ABB
"ColorTable09"=dword:00AA98F9
"ColorTable10"=dword:006ACE9E
"ColorTable11"=dword:0068AFE0
"ColorTable12"=dword:00F79ABB
"ColorTable13"=dword:00F9B697
"ColorTable14"=dword:00FFCF7D
"ColorTable15"=dword:00F5CAC0

