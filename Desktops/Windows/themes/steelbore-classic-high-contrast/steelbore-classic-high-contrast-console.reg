[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00270000
"ColorTable01"=dword:008080FF
"ColorTable02"=dword:007BFA50
"ColorTable03"=dword:00328ED9
"ColorTable04"=dword:00DCAE7F
"ColorTable05"=dword:00DCAE7F
"ColorTable06"=dword:00FDE98B
"ColorTable07"=dword:00328ED9
"ColorTable08"=dword:00DCAE7F
"ColorTable09"=dword:008080FF
"ColorTable10"=dword:007BFA50
"ColorTable11"=dword:00328ED9
"ColorTable12"=dword:00DCAE7F
"ColorTable13"=dword:00DCAE7F
"ColorTable14"=dword:00FDE98B
"ColorTable15"=dword:00328ED9

