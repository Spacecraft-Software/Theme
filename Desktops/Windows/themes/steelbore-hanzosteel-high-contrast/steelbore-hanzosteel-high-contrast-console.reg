[HKEY_CURRENT_USER\Console]
"FaceName"="Inconsolata"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00100000
; ScreenColors: low nibble = background index, high nibble =
; foreground index. Background is always ColorTable00, foreground
; ColorTable07 in the ANSI 16 layout, so this is fixed at 0x07.
"ScreenColors"=dword:00000007

"ColorTable00"=dword:00000000
"ColorTable01"=dword:008F8FFF
"ColorTable02"=dword:009BE45B
"ColorTable03"=dword:002AD0F7
"ColorTable04"=dword:0000B9F4
"ColorTable05"=dword:0012D6FC
"ColorTable06"=dword:0012D6FC
"ColorTable07"=dword:00E6F0F5
"ColorTable08"=dword:0000B9F4
"ColorTable09"=dword:008F8FFF
"ColorTable10"=dword:009BE45B
"ColorTable11"=dword:002AD0F7
"ColorTable12"=dword:0000B9F4
"ColorTable13"=dword:0012D6FC
"ColorTable14"=dword:0012D6FC
"ColorTable15"=dword:00E6F0F5

