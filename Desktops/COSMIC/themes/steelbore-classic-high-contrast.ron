// Steelbore Classic High Contrast — COSMIC desktop theme
// GENERATED by tools/steelbore_themes from Steelbore/steelbore.toml (palette family v3.5.0, The Steelbore Standard §11 v2.08). Do not edit by hand — regenerate.
// Theme slug: steelbore-classic-high-contrast · palette: steelbore-classic · variant: high-contrast (§11.1.1 accessible-mode sibling)
// Conformance: legacy six-role contract (§11.2); measured against Void Navy
// Maintainer: Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org> · https://Theme.SpacecraftSoftware.org/

(
    name: "Steelbore Classic High Contrast",
    is_dark: true,
    is_high_contrast: true,
    accent: "#7FAEDC",

    // Backgrounds — the canvas, then the elevated panel/dock fill.
    bg_color: "#000027",
    container_bg_color: "#000027",

    // Text — body copy on the canvas and on the container fill; both
    // are the same verified foreground-on-background pairing (§11.0.1).
    text_color: "#D98E32",
    container_text_color: "#D98E32",
    accent_text_color: "#000027",

    // Buttons — a surface fill with body text, plus the accent button
    // whose fill is the accent and whose text is the canvas (the same
    // pairing measured the other way round, §11.0.1 rule 3).
    button_bg_color: "#000027",
    button_fg_color: "#D98E32",
    accent_button_bg_color: "#7FAEDC",
    accent_button_text_color: "#000027",

    // Links, borders and the active-window focus ring.
    link_text_color: "#7FAEDC",
    border_color: "#7FAEDC",
    focus_color: "#8BE9FD",

    // States. success/destructive fills pair with canvas text — the
    // same allowed inversion as the accent button (§11.0.1 rule 3).
    // warning has no such verified inversion in every palette (the
    // contract permits it only for accent/structure/success/error), so
    // warning carries no paired text colour here.
    success_color: "#50FA7B",
    success_text_color: "#000027",
    warning_color: "#D98E32",
    destructive_color: "#FF8080",
    destructive_text_color: "#000027",

    // Advanced component overrides — panel keeps the canvas, dock
    // steps up to the container fill (the same pairing System76's
    // legacy file used).
    components: {
        "panel": (
            bg_color: Some("#000027"),
        ),
        "dock": (
            bg_color: Some("#000027"),
        ),
    },
)
